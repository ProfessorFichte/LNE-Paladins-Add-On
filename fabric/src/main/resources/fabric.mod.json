{
	"schemaVersion": 1,
	"id": "lne_paladins",
	"version": "${version}",
	"name": "LNE Paladins & Priests Add-On",
	"description": "Loot & Explore Add-On with Paladins RPG-Series Content.",
	"authors": [
		"Fichte"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/lne-paladins",
		"sources": "https://github.com/ProfessorFichte/LNE-Paladins-Add-On",
		"issues": "https://github.com/ProfessorFichte/LNE-Paladins-Add-On/issues"
	},
	"license": "ARR",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"client":[
			"com.lne_paladins.fabric.client.FabricClient"
		],
		"main": [
          "com.lne_paladins.fabric.FabricMod"
		],
		"fabric-datagen": [
			"com.lne_paladins.Lne_paladinsDataGenerator"
		]
	},
	"mixins": [
		"lne_paladins.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_compat_version}",
		"minecraft": ">=${minecraft_compat_version}",
		"java": ">=21",
		"fabric-api": "*",
		"armor_model_api": ">=${armor_model_api_version}",
		"spell_engine": ">=${spell_engine_version}",
		"paladins": ">=${paladins_version}",
		"mrpg_lib": ">=${more_rpg_library_version}"
	},
	"suggests": {
		"loot_n_explore": ">=${loot_n_explore_version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/AShKd5XrTu",
				"modmenu.kofi": "https://ko-fi.com/fichteee",
				"modmenu.modrinth": "https://modrinth.com/mod/lne-paladins"
			}
		}
	}
}